# Normalize EOL for all files that Git considers text files
* text=auto eol=lf

# Godot files
*.gd text
*.cs text
*.tres text
*.tscn text
*.cfg text
*.godot text

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.tga binary
*.svg binary
*.ico binary
*.wav binary
*.ogg binary
*.mp3 binary
*.mp4 binary
*.avi binary
*.mov binary
*.fbx binary
*.obj binary
*.dae binary
*.blend binary
*.3ds binary
*.max binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# Import files (generated by Godot)
*.import binary
