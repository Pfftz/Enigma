join green_interviewer center

green_interviewer: Terakhir...
green_interviewer: Bagaimana anda berkontribusi untuk lingkungan?

# Check bubble minigame score to determine choice
if {bubble_score} >= 50:
	# Good performance - player gives correct answer
	character: Saya aktif dalam program daur ulang, menggunakan transportasi ramah lingkungan, dan mendukung produk berkelanjutan
	set {interview_score} += 20

	green_interviewer: Sangat baik. Komitmen lingkungan yang nyata.
	[signal arg="correct_choice"]
else:
	# Poor performance - player gives wrong answer  
	character: Emm... saya kadang-kadang tidak buang sampah sembarangan
	set {interview_score} -= 10

	green_interviewer: Kurang meyakinkan. Kami butuh komitmen yang lebih kuat.
	[signal arg="wrong_choice"]

[wait time="1.0"]
[signal arg="update_ui"]
[signal arg="next_question"]