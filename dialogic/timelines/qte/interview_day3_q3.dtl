[background arg="res://asset/2d/hr/d3/bg-place.png" fade="0.0"]
join creative_interviewer (netral) center
join character center

creative_interviewer (netral): Pertarungan tadi menguji refleksmu. Sekarang, aku ingin melihat fondasi-mu.
creative_interviewer (netral): Setiap prajurit hidup dengan sebuah kredo. Sebuah prinsip yang tidak akan pernah ia langgar. Apa 'Prinsip Bushido'-mu, anak muda?

[signal arg="timer_start"]

- Mengabdi pada kewajiban di atas segalanya, Jenderal.
	[sound path="res://sounds/SFX/MOOD_UP.wav" volume="0.0"]
	set {interview_score} += 10.0
	
	
	[signal arg="timer_end"]
	creative_interviewer (senyum): Jawaban seorang samurai sejati! Kewajiban adalah napas kita!
	[signal arg="correct_choice"]

- Kesetiaan pada rekan dan atasan saya.
	[sound path="res://sounds/SFX/MOOD_UP.wav" volume="0.0"]
	set {interview_score} += 5.0
	[signal arg="timer_end"]
	
	creative_interviewer (senyum): Kesetiaan adalah lem yang merekatkan pasukan. Prinsip yang bagus.
	[signal arg="correct_choice"]

- Bertahan hidup adalah prinsip utama saya.
	[sound path="res://sounds/SFX/MOOD_DOWN.wav" volume="0.0"]
	set {interview_score} -= 5.0
	
	[signal arg="timer_end"]
	creative_interviewer (marah): Hanya bertahan hidup? Seekor kelinci pun bisa melakukannya. Di mana kehormatanmu?
	[signal arg="wrong_choice"]

- Prinsip saya: selesaikan misi, dapatkan bayaran.
	[sound path="res://sounds/SFX/MOOD_DOWN.wav" volume="0.0"]
	set {interview_score} -= 10.0
	
	[signal arg="timer_end"]
	creative_interviewer (marah): Kau seorang prajurit bayaran? Jiwamu kosong dan hanya terikat pada emas.
	[signal arg="wrong_choice"]

[wait time="1.0"]
[signal arg="update_ui"]
[signal arg="next_question"]
