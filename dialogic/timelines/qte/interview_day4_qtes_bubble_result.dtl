[background arg="res://asset/2d/hr/d3/bg-place.png" fade="0.0"]
join green_interviewer center
join character center

# Check bubble minigame score to determine choice
if {bubble_score} >= 10000000:
	[sound path="res://sounds/SFX/MOOD_UP.wav" volume="0.0"]
	# Good performance - player gives correct answer
	character (normal): icikiwir
	set {interview_score} += 10.0
	
	creative_interviewer (senyum): gg amat wok
	[signal arg="correct_choice"]
else:
	[sound path="res://sounds/SFX/MOOD_DOWN.wav" volume="0.0"]
	# Poor performance - player gives wrong answer  
	character (normal): cukup...
	character (normal): aku sudah muak dengan caramu memandang rendah orang lain...” \
“kepingan salju ini... kepingan salju itu...
	character (normal): SEMUA KEPINGAN SALJU DI BUMI ITU... TIDAK ADA YANG SAMA!!!
	green_interviewer (netral): (!!!)
	character (normal): SETIAP KEPINGAN SALJU ITU MEMILIKI POLA UNIKNYA SENDIRI !!!
	character (normal): DAN POLA ITU, BUKAN UNTUK ANDA NILAI !!!
	character (normal): AKULAH YANG MENENTUKAN NILAI KU SENDIRI !!!
	character (normal): AKU AKAN BUKTIKAN KAU SALAH, DASAR PENGUIN AROGAN!!!
	character (normal): JANGAN PERNAH MEREMEHKAN KAMI KEPINGAN SALJU!!!
	character (normal): SELAMAT TINGGAL!
	set {interview_score} -= 10.0
	[signal arg="wrong_choice"]

[wait time="1.0"]
[signal arg="update_ui"]
set {day4_completed} = true
set {day4_score} = {interview_score}
# Final interview conclusion
