join bananazon_interviewer center

bananazon_interviewer: Terakhir - Mengapa anda tertarik bekerja di bananazon?

[signal arg="timer_start"]

- Karena bananazon adalah perusahaan yang inovatif
	set {interview_score} += 10
	set {interview_health} += 10
	[signal arg="timer_end"]
	bananazon_interviewer: Terima kasih! Kami memang selalu berusaha berinovasi.
	[signal arg="correct_choice"]

- Karena gajinya besar
	set {interview_score} -= 5
	set {interview_health} -= 5
	[signal arg="timer_end"]
	bananazon_interviewer: Motivasi finansial saja tidak cukup untuk sukses disini.
	[signal arg="wrong_choice"]

- Saya ingin berkembang bersama perusahaan yang solid
	set {interview_score} += 15
	set {interview_health} += 15
	[signal arg="timer_end"]
	bananazon_interviewer: Perfect! Itulah mindset yang kami cari.
	[signal arg="correct_choice"]

- Karena deket dari rumah
	set {interview_score} -= 10
	set {interview_health} -= 10
	[signal arg="timer_end"]
	bananazon_interviewer: Itu bukan alasan yang kuat untuk bergabung dengan tim kami.
	[signal arg="wrong_choice"]

[wait time="1.0"]
[signal arg="update_ui"]

# Final interview conclusion
[wait time="1.0"]

bananazon_interviewer: Baiklah, interview hari ini selesai. Terima kasih atas waktunya.

if {interview_score} >= 25:
	bananazon_interviewer: Saya terkesan dengan jawaban anda! Kami akan menghubungi anda segera.
elif {interview_score} >= 10:
	bananazon_interviewer: Tidak buruk. Kami akan pertimbangkan aplikasi anda.
elif {interview_score} >= 0:
	bananazon_interviewer: Masih ada yang perlu diperbaiki, tapi terima kasih sudah datang.
else:
	bananazon_interviewer: Mohon maaf, sepertinya anda belum cocok untuk posisi ini.

set {day1_completed} = true
set {day1_score} = {interview_score}

leave bananazon_interviewer
