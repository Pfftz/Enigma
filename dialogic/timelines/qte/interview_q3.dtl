[background arg="res://asset/2d/hr/d1/hr-1-placehold.png" fade="0.0"]
join bananazon_interviewer center
join character center
bananazon_interviewer (sangat senang): Baiklah, pertanyaan terakhir untuk melihat visi jangka panjang Anda

bananazon_interviewer (netral): dimana anda melihat diri anda 5 tahun keepan?

[signal arg="timer_start"]

- Menjadi pupuk terbaik bagi Anda.
	[sound path="res://sounds/SFX/Mood_Down_New.wav" volume="0.0"]
	set {interview_score} += 15.0
	
	[signal arg="timer_end"]
	bananazon_interviewer (netral): …Sebuah kehormatan. Pengorbanan tertinggi.
	[signal arg="correct_choice"]

- 5 tahun? Pak, tagihan internet saya jatuh tempo besok.
	[sound path="res://sounds/SFX/MOOD_DOWN.wav" volume="0.0"]
	set {interview_score} -= 5
	
	[signal arg="timer_end"]
	bananazon_interviewer (marah): Perspektif yang sangat… jangka pendek. Seperti rumput liar.
	[signal arg="correct_choice"]

- Memberi dampak positif di sini
	[sound path="res://sounds/SFX/MOOD_UP.wav" volume="0.0"]
	set {interview_score} += 10.0
	
	[signal arg="timer_end"]
	bananazon_interviewer (senang): Visi yang bagus dan aman.
	[signal arg="wrong_choice"]

- DI MANA SAJA ASALKAN BUKAN DI JALANAN PAK! TOLONG PAK RUMAH SAYA MAU DISEGEL!
	[sound path="res://sounds/SFX/MOOD_DOWN.wav" volume="0.0"]
	set {interview_score} -= 10
	
	[signal arg="timer_end"]
	bananazon_interviewer (marah): Disegel? Seperti buah mangga agar cepat matang?”
	bananazon_interviewer (netral): Sedih sekali.
	[signal arg="wrong_choice"]

[wait time="1.0"]
[signal arg="update_ui"]

# Final interview conclusion
[wait time="1.0"]

bananazon_interviewer (netral): Analisa saya tentang Anda sudah cukup.

if {interview_score} >= 25:
	bananazon_interviewer (sangat senang): Anda punya potensi untuk tumbuh subur di sini. Kami akan kabari Anda di beberapa hari lagi
	bananazon_interviewer (netral): Maaf, sepertinya akar Anda tidak cocok dengan tanah kami. Terima kasih atas waktunya
else:
	bananazon_interviewer (marah): Maaf, sepertinya akar Anda tidak cocok dengan tanah kami. Terima kasih atas waktunya

set {day1_completed} = true
set {day1_score} = {interview_score}
