join green_interviewer center

green_interviewer: apa kelemahan terbesar anda

[signal arg="timer_start"]

- saya tidak suka basa-basi
	set {interview_score} += 15
	set {interview_health} += 15
	[signal arg="timer_end"]
	green_interviewer: Bagi saya itu adalah hal normal
	[signal arg="correct_choice"]

- Mungkin saya tidak bisa menyerah?
	set {interview_score} += 8
	set {interview_health} += 8
	[signal arg="timer_end"]
	green_interviewer: saya mengerti, meskipun itu tidak berguna untuk saya
	[signal arg="correct_choice"]

- Tebak dong hehe
	set {interview_score} += 10
	set {interview_health} += 10
	[signal arg="timer_end"]
	green_interviewer: saya bukan cenayang
	[signal arg="correct_choice"]

- mudah lapar
	set {interview_score} -= 15
	set {interview_health} -= 15
	[signal arg="timer_end"]
	green_interviewer: ...
	[signal arg="wrong_choice"]

[wait time="1.0"]
[signal arg="update_ui"]

leave green_interviewer
