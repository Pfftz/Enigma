[background arg="res://asset/2d/hr/d4/img-d4.png" fade="0.0"]
join green_interviewer center

green_interviewer (netral): Dengar baik-baik. Para kepingan salju diluar sana sudah apply di posisi yg sama sepertimu. Bagi saya... semuanya sama.

[signal arg="timer_start"]

- KEPINGAN SALJU DI BUMI ITU TIDAK ADA YANG SAMA
	set {interview_score} += 20

	[signal arg="timer_end"]
	green_interviewer (marah): ...
	[signal arg="correct_choice"]
	set {day4_completed} = true
	set {day4_score} = {interview_score}
	leave green_interviewer

- SETIAP KEPINGAN SALJU ITU MEMILIKI POLA UNIKNYA SENDIRI
	set {interview_score} += 12

	[signal arg="timer_end"]
	green_interviewer (marah): ...
	[signal arg="correct_choice"]
	set {day4_completed} = true
	set {day4_score} = {interview_score}
	leave green_interviewer

- SAYA ADALAH SAYA, MEREKA ADALAH MEREKA
	set {interview_score} -= 5

	[signal arg="timer_end"]
	green_interviewer (marah): ...
	[signal arg="wrong_choice"]
	set {day4_completed} = true
	set {day4_score} = {interview_score}
	leave green_interviewer

- JANGAN MEREMEHKAN KAMI KEPINGAN SALJU
	set {interview_score} -= 15

	[signal arg="timer_end"]
	green_interviewer (marah): ...
	[signal arg="wrong_choice"]
	set {day4_completed} = true
	set {day4_score} = {interview_score}
	leave green_interviewer
[end_timeline]
