join bananazon_interviewer center
# Question 3 timeout
set {interview_score} -= 5
set {interview_health} -= 10

bananazon_interviewer: ok 

[signal arg="timeout"]
[signal arg="timer_end"]
[signal arg="update_ui"]

[wait time="2.0"]

bananazon_interviewer: Baiklah, interview hari ini selesai. Terima kasih atas waktunya.

if {interview_score} >= 25:
	bananazon_interviewer: Saya terkesan dengan jawaban anda! Kami akan menghubungi anda segera.
else:
	bananazon_interviewer: Mohon maaf, sepertinya anda belum cocok untuk posisi ini.

set {day1_completed} = true
set {day1_score} = {interview_score}

leave bananazon_interviewer
