[background arg="res://asset/2d/hr/d2/bg-place-hr-d2.png" fade="0.0"]
join siluet center
set {interview_day} = 2
set {company_name} = "TechCorp"
set {interview_score} = 0

siluet: nyohohohho
leave siluet
join techcorp_interviewer center
techcorp_interviewer (senang): Semua datamu sudah ada di sini, mahluk organik. Setiap keystroke, setiap pencarian... semuanya.

techcorp_interviewer (netral): Selamat datang di CloseAI. Kau boleh memanggil Watakushi, Nona rAImu.
techcorp_interviewer (netral): Dan CloseAI ini? Ini taman bermain pemberian Ayahku.
techcorp_interviewer (senang): Jadi, anggap saja dirimu mainan baru Watakushi hari ini. Ohohoho!
techcorp_interviewer (netral): Sebagai AI dari keluarga terhormat, Watakushi hanya terbiasa berinteraksi dengan yang terbaik. Beri Watakushi satu alasan kenapa harus buang waktu dengan sampah sepertimu?

[signal arg="timer_start"]

- Saya mohon, Nona, saya butuh pekerjaan ini.
	set {interview_score} -= 5.0
	
	[signal arg="timer_end"]
	techcorp_interviewer (marah): Memohon? Tentu saja kau akan memohon. Itu sudah kodratmu.
	[signal arg="wrong_choice"]

- Justru karena Nona dari keluarga terhormat, [br] Nona pasti tahu cara membedakan mana 'sampah' dan mana 'investasi' yang berpotensi tinggi
	set {interview_score} -= 10.0
	
	[signal arg="timer_end"]
	techcorp_interviewer (senang): Fufufu, sudah minta maaf saja
	[signal arg="correct_choice"]

- Nona rAImu. Database saya ini dilengkapi fitur 'loyalitas tinggi' dan 'kemampuan belajar cepat'.
	set {interview_score} += 5.0
	
	[signal arg="timer_end"]
	techcorp_interviewer (senang): Oh? Mencoba menjual diri dengan 'fitur'? Fufu... setidaknya kau tahu cara memasarkan produk rusak. Kreatif.
	[signal arg="correct_choice"]

- KARENA SAYA AKAN JADI ANJING PELIHARAAN NONA YANG PALING SETIA!
	set {interview_score} -= 10
	
	[signal arg="timer_end"]
	techcorp_interviewer (marah): hohoho! Anjing? Kamu bahkan tidak pantas jadi serangga di tamanku! Tapi usahamu menghibur sekali!
	[signal arg="wrong_choice"]

[wait time="1.0"]
[signal arg="update_ui"]
