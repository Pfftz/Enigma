[background arg="res://asset/2d/hr/d3/bg-place.png" fade="0.0"]
join creative_interviewer center

# Check bubble minigame score to determine choice
if {bubble_score} >= 50:
	# Good performance - player gives correct answer
	character (normal): Saya akan hadapi Naga itu secara langsung! Berikan saya akses ke sistem inti, [br] saya akan pasang antivirus terkuat dan melawan balik firewall-nya [br] dengan segenap kekuatan saya!
	set {interview_score} += 15
	
	creative_interviewer (senyum): Hooo Jawaban yang sangat hebat anak muda, sangat jarang seseorang yang mempunyai strategi hebat sepertimu
	[signal arg="correct_choice"]
else:
	# Poor performance - player gives wrong answer  
	character (normal): gimana kalo saya bareng naga nya mukulin bapak  ?
	set {interview_score} -= 5
	
	creative_interviewer (marah): Hoho sanggup kah kamu menahan satu tebasan pedangku   ?
	[signal arg="wrong_choice"]

[wait time="1.0"]
[signal arg="update_ui"]
[signal arg="next_question"]
