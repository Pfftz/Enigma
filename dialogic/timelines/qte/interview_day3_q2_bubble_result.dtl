[background arg="res://asset/2d/hr/d3/bg-place.png" fade="0.0"]
join creative_interviewer center
join character center

# Check bubble minigame score to determine choice
if {bubble_score} >= 50:
	[sound path="res://sounds/SFX/MOOD_UP.wav" volume="0.0"]
	# Good performance - player gives correct answer
	character (normal): Saya akan hadapi langsung! Beri saya akses ke sistem inti, saya akan pasang antivirus terkuat !
	set {interview_score} += 10.0
	
	creative_interviewer (senyum): ooo! Jawaban yang hebat, anak muda! Maju dan hadapi ancaman itu dengan segenap jiwamu!
	[signal arg="correct_choice"]
else:
	[sound path="res://sounds/SFX/MOOD_DOWN.wav" volume="0.0"]
	# Poor performance - player gives wrong answer  
	character (normal): Kita telepon customer service antivirusnya saja, Jenderal?
	set {interview_score} -= 10.0
	
	creative_interviewer (marah): [i]Customer Service?[/i] Tanggung Jawab seorang prajurit tidak bisa dilempar ke orang lain begitu saja!
	[signal arg="wrong_choice"]

[wait time="1.0"]
[signal arg="update_ui"]
[signal arg="next_question"]
