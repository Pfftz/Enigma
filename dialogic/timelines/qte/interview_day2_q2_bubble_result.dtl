join techcorp_interviewer center

techcorp_interviewer: Sekarang untuk pertanyaan terakhir...
techcorp_interviewer: Bagaimana anda mengatasi stres kerja?

# Check bubble minigame score to determine choice
if {bubble_score} >= 50:
	# Good performance - player gives correct answer
	character: Saya menggunakan teknik mindfulness dan time management yang baik
	set {interview_score} += 12

	techcorp_interviewer: That's a professional approach. Good stress management skills.
	[signal arg="correct_choice"]
else:
	# Poor performance - player gives wrong answer  
	character: Saya... biasanya panik dan tidak tahu harus bagaimana
	set {interview_score} -= 8

	techcorp_interviewer: That's... concerning. Stress management is crucial in tech.
	[signal arg="wrong_choice"]

[wait time="1.0"]
[signal arg="update_ui"]
[signal arg="next_question"]