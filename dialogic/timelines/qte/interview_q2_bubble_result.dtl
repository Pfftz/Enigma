[background arg="res://asset/2d/hr/d1/hr-1-placehold.png" fade="0.0"]
join character center
join bananazon_interviewer center

# Check bubble minigame score to determine choice
if {bubble_score} >= 50:
	[sound path="res://sounds/SFX/MOOD_UP.wav" volume="0.0"]
	# Good performance - player gives correct answer
	character (normal): Ada dua. Jendela kesempatan dan jendela dunia
	set {interview_score} += 10
	
	bananazon_interviewer (sangat senang): Jawaban yang sangat bijak. Anda melihat melampaui fisik.
	[signal arg="correct_choice"]
else:
	[sound path="res://sounds/SFX/MOOD_DOWN.wav" volume="0.0"]
	# Poor performance - player gives wrong answer  
	character (normal): um... lebih dari 3
	set {interview_score} += 15
	
	bananazon_interviewer (marah): Ahh… butuh lebih banyak menyentuh rumput sepertinya.
	[signal arg="wrong_choice"]

[wait time="1.0"]
[signal arg="update_ui"]
[signal arg="next_question"]
