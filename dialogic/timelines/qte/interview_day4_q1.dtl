[background arg="res://asset/2d/hr/d4/img-d4.png" fade="0.0"]
join green_interviewer center
set {interview_day} = 4
set {company_name} = "GreenCorp"
set {interview_score} = 0
set {interview_health} = 10
character: Permisi pak

green_interviewer: “Pelamar ke-456 Waktu saya terbatas. Saya harap anda sudah siap

[signal arg="timer_start"]

- (diam)*mengaangguk
	set {interview_score} += 18
	set {interview_health} += 18
	[signal arg="timer_end"]
	green_interviewer: baik. Saya suka itu
	[signal arg="correct_choice"]

- setuju pak, waktu itu berharga
	set {interview_score} += 5
	set {interview_health} += 5
	[signal arg="timer_end"]
	green_interviewer: Bagus kalau Anda sadar.
	[signal arg="correct_choice"]

- Sudah 456 orang yg mendaftar?
	set {interview_score} -= 20
	set {interview_health} -= 20
	[signal arg="timer_end"]
	green_interviewer: fokus. Itu tidak relevan
	[signal arg="wrong_choice"]

- gak sabaran banget pak
	set {interview_score} -= 10
	set {interview_health} -= 10
	[signal arg="timer_end"]
	green_interviewer: Maaf? Sikap Anda kami catat. Mari kita lihat apakah kemampuan anda bisa menutupi itu
	[signal arg="wrong_choice"]

[wait time="1.0"]
[signal arg="update_ui"]
