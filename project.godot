; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Enigma"
run/main_scene="res://post_process/pp_stack.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Global="*res://scripts/autoloads/global.gd"
Dialogic="*res://addons/dialogic/Core/DialogicGameHandler.gd"
BgMusic="*res://scripts/autoloads/bg_music.gd"
EventBus="*res://scripts/autoloads/event_bus.gd"
PhantomCameraManager="*res://addons/phantom_camera/scripts/managers/phantom_camera_manager.gd"
Bgmusic="*res://scenes/management/bgmusic.tscn"

[dialogic]

directories/dch_directory={
"unit_test_character": "res://Tests/Resources/unit_test_character.dch"
}
directories/dtl_directory={
"interview_intro": "res://dialogic/timelines/interview_intro.dtl"
}

[display]

window/stretch/mode="viewport"
window/vsync/vsync_mode=0

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg", "res://addons/phantom_camera/plugin.cfg")

[global_group]

player=""

