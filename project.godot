glossary/default_case_sensitive=true
layout/style_list=[]
layout/default_style="Default"
variables={
"company_name": "Test Company",
"day1_completed": false,
"day1_score": 0,
"day2_completed": false,
"day2_score": 0,
"day3_completed": false,
"day3_score": 0,
"day4_completed": false,
"day4_score": 0,
"day5_completed": false,
"day5_score": 0,
"force_continue": false,
"interview_day": 1,
"interview_health": 50,
"interview_score": 0,
"question_answered": false
}

[display]

window/stretch/mode="viewport"
window/vsync/vsync_mode=0

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg", "res://addons/phantom_camera/plugin.cfg")

[global_group]

player=""

