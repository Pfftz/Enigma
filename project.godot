; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Enigma"
run/main_scene="res://post_process/pp_stack.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Global="*res://scripts/autoloads/global.gd"
Dialogic="*res://addons/dialogic/Core/DialogicGameHandler.gd"
EventBus="*res://scripts/autoloads/event_bus.gd"
PhantomCameraManager="*res://addons/phantom_camera/scripts/managers/phantom_camera_manager.gd"
BGMusic="*res://scripts/autoloads/bg_music.gd"

[dialogic]

directories/dch_directory={
"bananazon_interviewer": "res://dialogic/characters/bananazon_interviewer.dch",
"creative_interviewer": "res://dialogic/characters/creative_interviewer.dch",
"green_interviewer": "res://dialogic/characters/green_interviewer.dch",
"mega_interviewer": "res://dialogic/characters/mega_interviewer.dch",
"player": "res://dialogic/characters/player.dch",
"techcorp_interviewer": "res://dialogic/characters/techcorp_interviewer.dch",
"unit_test_character": "res://Tests/Resources/unit_test_character.dch"
}
directories/dtl_directory={
"day1": "res://dialogic/timelines/day1.dtl",
"interview_day2_q1": "res://dialogic/timelines/interview_day2_q1.dtl",
